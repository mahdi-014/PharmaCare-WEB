# PharmaCare — Centralized Repository Git Ignore
# Single Source of Truth for Ignored Files, Logs, and Local Overrides

# 1. Operating System Metadata
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
.DS_Store
.AppleDouble
.LSOverride

# 2. IDE & Editor Configurations
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# 3. Environment Overrides & Credentials
config.local.php
.env
.env.local

# 4. Runtime Temporary Files & Logs
*.tmp
*.log
sess_*
cookies*.txt
scratch/

# 5. Local Database Dumps & Backup Archives
backups/
*.zip
*.tar.gz
*.bak
*.dump
*_dump.sql

# 6. Patient Uploaded Prescriptions (Confidential Medical Documents)
storage/prescriptions/*
!storage/prescriptions/.gitkeep
