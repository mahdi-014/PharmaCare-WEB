erDiagram
    %% =========================================================================
    %% PharmaCare: Pharmacy Management & Online Ordering System
    %% Entity Relationship Diagram (ERD) - Schema Specification
    %% CIS324 Web Engineering Semester Project
    %% Database Engine: MySQL / MariaDB InnoDB (utf8mb4)
    %% Tables: 10 | Columns: 104 | Primary Keys: 10 | Foreign Keys: 14
    %% =========================================================================

    %% -------------------------------------------------------------------------
    %% 1. User Accounts & Role-Based Access Control
    %% -------------------------------------------------------------------------
    app_users {
        int id PK "AUTO_INCREMENT"
        varchar full_name "NOT NULL"
        varchar username "UK, NOT NULL"
        varchar email "UK, NULL"
        varchar phone "NULL"
        text address "NULL"
        varchar password "NOT NULL, bcrypt"
        enum role "ADMIN, STAFF, CUSTOMER"
        tinyint enabled "NOT NULL, default 1"
        datetime created_at "NOT NULL, CURRENT_TIMESTAMP"
    }

    %% -------------------------------------------------------------------------
    %% 2. Pharmacological Therapeutic Categories
    %% -------------------------------------------------------------------------
    categories {
        int id PK "AUTO_INCREMENT"
        varchar name "UK, NOT NULL"
        varchar description "NULL"
        datetime created_at "NOT NULL, CURRENT_TIMESTAMP"
    }

    %% -------------------------------------------------------------------------
    %% 3. Pharmaceutical Suppliers / Manufacturers
    %% -------------------------------------------------------------------------
    suppliers {
        int id PK "AUTO_INCREMENT"
        varchar name "NOT NULL"
        varchar company_name "NULL"
        varchar phone "NOT NULL"
        varchar email "NULL"
        varchar address "NULL"
        datetime created_at "NOT NULL, CURRENT_TIMESTAMP"
    }

    %% -------------------------------------------------------------------------
    %% 4. Medicine Inventory, Formulations & Batches
    %% -------------------------------------------------------------------------
    medicines {
        int id PK "AUTO_INCREMENT"
        varchar name "NOT NULL"
        varchar generic_name "NOT NULL"
        varchar brand_name "NULL"
        varchar batch_number "UK, NOT NULL"
        enum medicine_type "TABLET, CAPSULE, SYRUP, etc."
        decimal purchase_price "chk >= 0, NOT NULL"
        decimal selling_price "chk >= 0, NOT NULL"
        int quantity "chk >= 0, NOT NULL, default 0"
        int minimum_stock_level "NOT NULL, default 10"
        date manufacturing_date "NULL"
        date expiry_date "NOT NULL"
        tinyint prescription_required "NOT NULL, default 0"
        tinyint active "NOT NULL, default 1"
        int category_id FK "NOT NULL"
        int supplier_id FK "NOT NULL"
        datetime created_at "NOT NULL, CURRENT_TIMESTAMP"
    }

    %% -------------------------------------------------------------------------
    %% 5. Customer Online Purchase Orders
    %% -------------------------------------------------------------------------
    orders {
        int id PK "AUTO_INCREMENT"
        varchar order_number "UK, NOT NULL"
        int customer_id FK "NOT NULL"
        varchar customer_name "NOT NULL"
        varchar customer_phone "NOT NULL"
        text delivery_address "NOT NULL"
        decimal subtotal "chk >= 0, NOT NULL"
        decimal shipping_fee "NOT NULL, default 0.00"
        decimal total_amount "chk >= 0, NOT NULL"
        enum order_status "PENDING, CONFIRMED, PROCESSING, READY, DISPATCHED, COMPLETED, CANCELLED"
        enum payment_method "COD, STORE_PICKUP"
        enum payment_status "UNPAID, PAID"
        tinyint prescription_required "NOT NULL, default 0"
        enum prescription_status "NOT_REQUIRED, PENDING_REVIEW, VERIFIED, REJECTED"
        text notes "NULL"
        tinyint stock_deducted "NOT NULL, default 1"
        tinyint stock_restored "NOT NULL, default 0"
        datetime created_at "NOT NULL, CURRENT_TIMESTAMP"
        datetime updated_at "NOT NULL, ON UPDATE CURRENT_TIMESTAMP"
    }

    %% -------------------------------------------------------------------------
    %% 6. Order Line Items (Historical Frozen Snapshots)
    %% -------------------------------------------------------------------------
    order_items {
        int id PK "AUTO_INCREMENT"
        int order_id FK "NOT NULL, CASCADE"
        int medicine_id FK "NOT NULL, RESTRICT"
        varchar medicine_name "NOT NULL, snapshot"
        varchar batch_number "NOT NULL, snapshot"
        int quantity "chk > 0, NOT NULL"
        decimal unit_price "chk >= 0, NOT NULL"
        decimal line_total "chk >= 0, NOT NULL"
    }

    %% -------------------------------------------------------------------------
    %% 7. Order Status Audit Trail & Lifecycle Tracking
    %% -------------------------------------------------------------------------
    order_status_history {
        int id PK "AUTO_INCREMENT"
        int order_id FK "NOT NULL, CASCADE"
        varchar previous_status "NULL"
        varchar new_status "NOT NULL"
        int changed_by_id FK "NOT NULL, RESTRICT"
        text remarks "NULL"
        datetime created_at "NOT NULL, CURRENT_TIMESTAMP"
    }

    %% -------------------------------------------------------------------------
    %% 8. Prescription Uploads & Verification Workflow
    %% -------------------------------------------------------------------------
    prescriptions {
        int id PK "AUTO_INCREMENT"
        int order_id FK "NOT NULL, CASCADE"
        int customer_id FK "NOT NULL, RESTRICT"
        varchar file_path "NOT NULL"
        varchar original_filename "NOT NULL"
        int file_size "NOT NULL"
        varchar mime_type "NOT NULL"
        enum verification_status "PENDING, APPROVED, REJECTED"
        int reviewed_by_id FK "NULL, SET NULL"
        text review_notes "NULL"
        datetime reviewed_at "NULL"
        datetime created_at "NOT NULL, CURRENT_TIMESTAMP"
    }

    %% -------------------------------------------------------------------------
    %% 9. Sales Ledger Transactions (POS Walk-in & Online Fulfillment)
    %% -------------------------------------------------------------------------
    sales {
        int id PK "AUTO_INCREMENT"
        varchar invoice_number "UK, NOT NULL"
        datetime sale_date "NOT NULL, CURRENT_TIMESTAMP"
        varchar customer_name "NULL, walk-in"
        varchar customer_phone "NULL, walk-in"
        decimal subtotal "chk >= 0, NOT NULL"
        decimal discount "NOT NULL, default 0.00"
        decimal total_amount "chk >= 0, NOT NULL"
        int sold_by_id FK "NOT NULL, RESTRICT"
        varchar channel "NOT NULL, default POS"
        int order_id FK "NULL, SET NULL, online bridge"
    }

    %% -------------------------------------------------------------------------
    %% 10. Sales Line Items (Historical Frozen Snapshots)
    %% -------------------------------------------------------------------------
    sale_items {
        int id PK "AUTO_INCREMENT"
        int sale_id FK "NOT NULL, CASCADE"
        int medicine_id FK "NOT NULL, RESTRICT"
        varchar medicine_name "NOT NULL, snapshot"
        varchar generic_name "NULL, snapshot"
        varchar batch_number "NOT NULL, snapshot"
        int quantity "chk > 0, NOT NULL"
        decimal unit_price "chk >= 0, NOT NULL"
        decimal line_total "chk >= 0, NOT NULL"
    }

    %% =========================================================================
    %% Verified Foreign Key Relationships & Structural Cardinalities
    %% =========================================================================
    categories ||--o{ medicines : "categorizes"
    suppliers ||--o{ medicines : "supplies"
    app_users ||--o{ orders : "places"
    orders ||--|{ order_items : "contains"
    medicines ||--o{ order_items : "ordered_in"
    orders ||--o{ order_status_history : "tracks"
    app_users ||--o{ order_status_history : "recorded_by"
    orders ||--o| prescriptions : "requires_upload"
    app_users ||--o{ prescriptions : "uploaded_by"
    app_users |o--o{ prescriptions : "reviewed_by"
    app_users ||--o{ sales : "processed_by"
    orders |o--o| sales : "bridges_to"
    sales ||--|{ sale_items : "contains"
    medicines ||--o{ sale_items : "sold_in"
